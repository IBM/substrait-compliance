# Multi-stage build for Substrait Compliance API
# Optimized for Podman but compatible with Docker
#
# Build strategy: sdk/java (shadow 9.6.1) requires Gradle 9; api (Spring Boot 2.7)
# requires Gradle 8 because io.spring.dependency-management removes
# LenientConfiguration.getFiles() in Gradle 9.  The two modules are built in
# separate stages so each uses its own compatible Gradle image.

# ── Stage 1: Build the SDK fat jar (Gradle 9) ─────────────────────────────────
FROM gradle:9.6.1-jdk17 AS sdk-builder

WORKDIR /build

COPY settings.gradle .
COPY sdk/java/build.gradle sdk/java/
COPY sdk/java/gradle sdk/java/gradle
COPY sdk/java/gradlew sdk/java/gradlew
COPY sdk/java/src sdk/java/src

RUN gradle :sdk:java:shadowJar --no-daemon -q

# ── Stage 2: Build the API bootJar (Gradle 8) ─────────────────────────────────
FROM gradle:8.14.5-jdk17 AS api-builder

WORKDIR /build

# api/settings.gradle becomes the root settings file for this standalone build
COPY api/settings.gradle .
COPY api/build.gradle build.gradle
COPY api/gradle gradle
COPY api/gradlew gradlew

# Bring the SDK fat jar in from the previous stage
COPY --from=sdk-builder /build/sdk/java/build/libs/substrait-compliance-*-all.jar \
     libs/substrait-compliance-all.jar

# Download dependencies (cached layer)
RUN gradle dependencies --no-daemon -q || true

COPY api/src src

RUN gradle bootJar --no-daemon -q

# ── Stage 3: Runtime ──────────────────────────────────────────────────────────
FROM eclipse-temurin:17-jre-jammy

# Install curl for healthcheck
RUN apt-get update -q && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the built JAR from the API builder stage
# In the standalone build the jar lands at /build/build/libs/ (rootDir/build/libs)
COPY --from=api-builder /build/build/libs/*.jar app.jar

# Create non-root user for security
RUN groupadd --system spring && useradd --system --gid spring spring
RUN chown -R spring:spring /app

# Switch to non-root user
USER spring:spring

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

# JVM options for container environment
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0"

# Run the application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
