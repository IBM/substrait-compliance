{
  "description": "How a query's output is compared with its expected output (sdk/conformance/README.md). Each vector has an expected and an actual table (names, types, rows) and whether they match. Values are JSON; {\"double\": \"<text>\"} is a double (e.g. NaN) and {\"decimal\": \"<text>\"} an exact decimal. declaredScales, when present, gives per column the scale of the decimal type the plan declares (null for other columns).",
  "vectors": [
    {"name": "a decimal declared with scale 2 matches within 0.01 (avg kept to 6 places)",
     "declaredScales": [2],
     "expected": {"names": ["avg_qty"], "types": ["double"], "rows": [[25.575154611454693]]},
     "actual":   {"names": ["AVG_QTY"], "types": ["decimal"], "rows": [[{"decimal": "25.575154"}]]}, "match": true},
    {"name": "a decimal declared with scale 2 matches the value rounded to 2 places",
     "declaredScales": [2],
     "expected": {"names": ["avg_qty"], "types": ["double"], "rows": [[25.575154611454693]]},
     "actual":   {"names": ["AVG_QTY"], "types": ["decimal"], "rows": [[{"decimal": "25.58"}]]}, "match": true},
    {"name": "a decimal declared with scale 2 matches the value truncated to 2 places",
     "declaredScales": [2],
     "expected": {"names": ["avg_qty"], "types": ["double"], "rows": [[25.575154611454693]]},
     "actual":   {"names": ["AVG_QTY"], "types": ["decimal"], "rows": [[{"decimal": "25.57"}]]}, "match": true},
    {"name": "a decimal declared with scale 2 does not match two units off",
     "declaredScales": [2],
     "expected": {"names": ["avg_qty"], "types": ["double"], "rows": [[25.575154611454693]]},
     "actual":   {"names": ["AVG_QTY"], "types": ["decimal"], "rows": [[{"decimal": "25.555"}]]}, "match": false},
    {"name": "without a declared scale the same value is compared to 1e-9",
     "expected": {"names": ["avg_qty"], "types": ["double"], "rows": [[25.575154611454693]]},
     "actual":   {"names": ["AVG_QTY"], "types": ["decimal"], "rows": [[{"decimal": "25.575154"}]]}, "match": false},
    {"name": "the declared scale applies only to its own column",
     "declaredScales": [null, 2],
     "expected": {"names": ["n", "avg"], "types": ["double", "double"], "rows": [[1.5, 2.0]]},
     "actual":   {"names": ["n", "avg"], "types": ["double", "double"], "rows": [[1.505, 2.004]]}, "match": false},
    {"name": "identical rows",
     "expected": {"names": ["n"], "types": ["integer"], "rows": [[1], [2]]},
     "actual":   {"names": ["n"], "types": ["integer"], "rows": [[1], [2]]}, "match": true},
    {"name": "column names compare case-insensitively",
     "expected": {"names": ["revenue"], "types": ["double"], "rows": [[1.5]]},
     "actual":   {"names": ["REVENUE"], "types": ["double"], "rows": [[1.5]]}, "match": true},
    {"name": "a different column name fails",
     "expected": {"names": ["sum(l_quantity)"], "types": ["double"], "rows": [[305.0]]},
     "actual":   {"names": ["TOTAL_QTY"], "types": ["double"], "rows": [[305.0]]}, "match": false},
    {"name": "a different row count fails",
     "expected": {"names": ["n"], "types": ["integer"], "rows": [[1], [2]]},
     "actual":   {"names": ["n"], "types": ["integer"], "rows": [[1]]}, "match": false},
    {"name": "rows are compared in order",
     "expected": {"names": ["n"], "types": ["integer"], "rows": [[1], [2]]},
     "actual":   {"names": ["n"], "types": ["integer"], "rows": [[2], [1]]}, "match": false},
    {"name": "integer, decimal and double are one numeric family",
     "expected": {"names": ["a", "b"], "types": ["double", "integer"], "rows": [[15.4865, 7]]},
     "actual":   {"names": ["a", "b"], "types": ["decimal(15,4)", "bigint"], "rows": [[{"decimal": "15.4865"}, 7]]}, "match": true},
    {"name": "a relative difference within 1e-9 matches",
     "expected": {"names": ["x"], "types": ["double"], "rows": [[1000000.0]]},
     "actual":   {"names": ["x"], "types": ["double"], "rows": [[1000000.0000001]]}, "match": true},
    {"name": "a decimal rounded to 6 digits does not match the full double",
     "expected": {"names": ["avg_qty"], "types": ["double"], "rows": [[25.575154611454693]]},
     "actual":   {"names": ["avg_qty"], "types": ["decimal(38,6)"], "rows": [[{"decimal": "25.575154"}]]}, "match": false},
    {"name": "values near zero use the absolute tolerance 1e-9",
     "expected": {"names": ["x"], "types": ["double"], "rows": [[0.0]]},
     "actual":   {"names": ["x"], "types": ["double"], "rows": [[1e-12]]}, "match": true},
    {"name": "NaN matches NaN",
     "expected": {"names": ["x"], "types": ["double"], "rows": [[{"double": "NaN"}]]},
     "actual":   {"names": ["x"], "types": ["double"], "rows": [[{"double": "NaN"}]]}, "match": true},
    {"name": "infinity matches only the same infinity",
     "expected": {"names": ["x"], "types": ["double"], "rows": [[{"double": "Infinity"}]]},
     "actual":   {"names": ["x"], "types": ["double"], "rows": [[{"double": "-Infinity"}]]}, "match": false},
    {"name": "NULL matches only NULL",
     "expected": {"names": ["x", "y"], "types": ["integer", "string"], "rows": [[null, null]]},
     "actual":   {"names": ["x", "y"], "types": ["integer", "string"], "rows": [[null, null]]}, "match": true},
    {"name": "NULL does not match zero",
     "expected": {"names": ["x"], "types": ["integer"], "rows": [[null]]},
     "actual":   {"names": ["x"], "types": ["integer"], "rows": [[0]]}, "match": false},
    {"name": "a numeric string matches the number",
     "expected": {"names": ["x"], "types": ["double"], "rows": [[42.5]]},
     "actual":   {"names": ["x"], "types": ["double"], "rows": [["42.5"]]}, "match": true},
    {"name": "numeric-looking text in a text column compares as text",
     "expected": {"names": ["code"], "types": ["varchar"], "rows": [["001"]]},
     "actual":   {"names": ["code"], "types": ["varchar"], "rows": [["1"]]}, "match": false},
    {"name": "strings compare exactly",
     "expected": {"names": ["s"], "types": ["varchar"], "rows": [["Customer#000000667"]]},
     "actual":   {"names": ["s"], "types": ["string"], "rows": [["customer#000000667"]]}, "match": false},
    {"name": "dates compare as text",
     "expected": {"names": ["d"], "types": ["date"], "rows": [["1995-10-21"]]},
     "actual":   {"names": ["d"], "types": ["varchar"], "rows": [["1995-10-21"]]}, "match": true},
    {"name": "a string column does not match a numeric one",
     "expected": {"names": ["x"], "types": ["varchar"], "rows": [["1"]]},
     "actual":   {"names": ["x"], "types": ["integer"], "rows": [[1]]}, "match": false},
    {"name": "booleans",
     "expected": {"names": ["b"], "types": ["boolean"], "rows": [[true], [false]]},
     "actual":   {"names": ["b"], "types": ["bool"], "rows": [[true], [false]]}, "match": true},
    {"name": "true does not match false",
     "expected": {"names": ["b"], "types": ["boolean"], "rows": [[true]]},
     "actual":   {"names": ["b"], "types": ["boolean"], "rows": [[false]]}, "match": false}
  ]
}
