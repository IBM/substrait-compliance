### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_string

# basic: Basic examples without any special cases
rtrim('abc'::str, ' '::str) = 'abc'::str
rtrim('   abc'::str, ' '::str) = '   abc'::str
rtrim('abc   '::str, ' '::str) = 'abc'::str
rtrim('   abc   '::str, ' '::str) = '   abc'::str
rtrim(''::str, ' '::str) = ''::str
rtrim(' '::str, ' '::str) = ''::str
rtrim(null::str?, ' '::str) = null::str?

# two_inputs: Examples with character input to trim off
rtrim('aaaaabccccc'::str, 'c'::str) = 'aaaaab'::str
rtrim('abcabcdef'::str, 'def'::str) = 'abcabc'::str
rtrim('defabccba'::str, 'abc'::str) = 'def'::str
