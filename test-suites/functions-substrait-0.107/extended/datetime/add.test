### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_datetime

# timestamps: examples using the timestamp types
add(2016-12-31T13:30:15::pts<6>, P5D::iday) = 2017-01-05T13:30:15::pts<6>
add(2016-12-01T13:30:15::pts<6>, PT5H::iday) = 2016-12-01T18:30:15::pts<6>

# date_to_timestamp: examples using the date types and resulting in a timestamp
add(2020-12-31::date, P5D::iday) = 2021-01-05T00:00:00::pts<6>

# null_input: examples with null args or return
add(null::date?, P5D::iday) = null::pts?<6>
add(2020-12-31::date, P-5D::iday) = 2020-12-26T00:00:00::pts<6>
add(2016-12-31T13:30:15::pts<6>, P-1Y::iyear) = 2015-12-31T13:30:15::pts<6>
add(2016-12-01T18:30:15::pts<6>, PT-5H::iday) = 2016-12-01T13:30:15::pts<6>
add(2020-12-31::date, P0D::iday) = 2020-12-31T00:00:00::pts<6>
add(2016-12-31T13:30:15::pts<6>, P0Y::iyear) = 2016-12-31T13:30:15::pts<6>
add(2016-12-31T23:59:59::pts<6>, PT1S::iday) = 2017-01-01T00:00:00::pts<6>
add(2020-02-28T23:59:59::pts<6>, PT1S::iday) = 2020-02-29T00:00:00::pts<6>
add(2020-12-31T23:59:59::pts<6>, PT3661S::iday) = 2021-01-01T01:01:00::pts<6>
add(null::pts?<6>, P5D::iday) = null::pts?<6>
add(2016-12-31T13:30:15::pts<6>, null::iday?) = null::pts?<6>
add(null::pts?<6>, null::iday?) = null::pts?<6>
add(9999-12-30::date, P1D::iday) = 9999-12-31T00:00:00::pts<6>
add(0001-01-02::date, P-1D::iday) = 0001-01-01T00:00:00::pts<6>
add(0001-01-01T00:00:00::pts<6>, P0D::iday) = 0001-01-01T00:00:00::pts<6>
