### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_datetime

# null_handling_extended: Extended null handling scenarios
subtract(null::pts?<6>, null::iday?) = null::pts?<6>
subtract(2020-12-31::date, null::iyear?) = null::date?
subtract(null::date?, null::iyear?) = null::date?

# zero_handling: Zero and negative zero handling
subtract(2016-01-01T00:00:00::pts<6>, PT1S::iday) = 2015-12-31T23:59:59::pts<6>
subtract(2020-01-01T00:00:00::pts<6>, PT1H::iday) = 2019-12-31T23:00:00::pts<6>

# negative_values: Negative number handling
subtract(2020-02-29::date, P1Y::iyear) = 2019-02-28::date
subtract(2024-02-29::date, P4Y::iyear) = 2020-02-29::date
subtract(2020-01-31::date, P1M::iyear) = 2019-12-31::date
subtract(2020-03-31::date, P1M::iyear) = 2020-02-29::date
subtract(2019-03-31::date, P1M::iyear) = 2019-02-28::date
subtract(2020-05-31::date, P1M::iyear) = 2020-04-30::date
subtract(2016-12-31T13:30:15::pts<6>, PT0S::iday) = 2016-12-31T13:30:15::pts<6>
subtract(2016-12-31T23:59:59::pts<6>, PT1S::iday) = 2016-12-31T23:59:58::pts<6>
