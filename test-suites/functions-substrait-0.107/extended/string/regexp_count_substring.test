### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_string

# zero_handling: Zero and negative zero handling
regexp_count_substring(''::str, 'a'::str, 1::i64) = 0::i64
regexp_count_substring(''::str, 'a'::str) = 0::i64
regexp_count_substring('abcabc'::str, 'a'::str, -1::i64) = 0::i64
regexp_count_substring('abcabc'::str, 'a'::str, 10::i64) = 0::i64

# empty_values: Empty strings and collections
regexp_count_substring('abc'::str, ''::str, 1::i64) = 4::i64
regexp_count_substring(''::str, ''::str, 1::i64) = 1::i64
regexp_count_substring('abc'::str, ''::str) = 4::i64

# type_coverage: Various data type coverage
regexp_count_substring('abcabc'::str, 'a'::str, 4::i64) = 1::i64
regexp_count_substring('abcabc'::str, 'abc'::str, 2::i64) = 1::i64
regexp_count_substring('AaBbCc'::str, 'a'::str, 1::i64) = 1::i64
regexp_count_substring('AaBbCc'::str, 'A'::str, 1::i64) = 1::i64
regexp_count_substring('HELLO hello HeLLo'::str, 'hello'::str, 1::i64) = 1::i64
regexp_count_substring('AaBbCc'::str, '[a-z]'::str, 1::i64) = 3::i64
regexp_count_substring('aaa'::str, 'aa'::str, 1::i64) = 1::i64
regexp_count_substring('aaaa'::str, 'aa'::str, 1::i64) = 2::i64
regexp_count_substring('ababa'::str, 'aba'::str, 1::i64) = 1::i64
regexp_count_substring('Москва'::str, '[а-я]'::str, 1::i64) = 5::i64

# unicode_handling: Unicode and special characters
regexp_count_substring('café'::str, 'é'::str, 1::i64) = 1::i64
regexp_count_substring('你好世界'::str, '好'::str, 1::i64) = 1::i64
regexp_count_substring('🎉🎊🎉'::str, '🎉'::str, 1::i64) = 2::i64
