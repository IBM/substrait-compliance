### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_comparison

# edge_cases: Boundary values and extreme inputs
lte(-128::i8, -127::i8) = true::bool
lte(-128::i8, -128::i8) = true::bool
lte(-128::i8, 0::i8) = true::bool
lte(-32768::i16, -32767::i16) = true::bool
lte(-32768::i16, -32768::i16) = true::bool
lte(-2147483648::i32, -2147483647::i32) = true::bool
lte(-2147483648::i32, -2147483648::i32) = true::bool
lte(-9223372036854775808::i64, -9223372036854775807::i64) = true::bool
lte(-9223372036854775808::i64, -9223372036854775808::i64) = true::bool
lte(127::i8, 127::i8) = true::bool
lte(127::i8, 126::i8) = false::bool
lte(32767::i16, 32767::i16) = true::bool
lte(32767::i16, 32766::i16) = false::bool
lte(2147483647::i32, 2147483647::i32) = true::bool
lte(2147483647::i32, 2147483646::i32) = false::bool
lte(9223372036854775807::i64, 9223372036854775807::i64) = true::bool
lte(9223372036854775807::i64, 9223372036854775806::i64) = false::bool

# special_values: Special floating point values (NaN, Infinity)
lte(nan::fp32, 5.0::fp32) = false::bool
lte(nan::fp64, 100.0::fp64) = false::bool
lte(-inf::fp64, -inf::fp64) = true::bool
lte(-inf::fp64, 0.0::fp64) = true::bool
lte(-inf::fp64, 1.5e+308::fp64) = true::bool
lte(-inf::fp32, -inf::fp32) = true::bool
lte(-inf::fp32, 0.0::fp32) = true::bool

# zero_handling: Zero and negative zero handling
lte(0.0::fp32, -0.0::fp32) = true::bool
lte(-0.0::fp32, 0.0::fp32) = true::bool
lte(0.0::fp64, -0.0::fp64) = true::bool
lte(-0.0::fp64, 0.0::fp64) = true::bool

# negative_values: Negative number handling
lte(-50::i8, -25::i8) = true::bool
lte(-25::i8, -50::i8) = false::bool
lte(-1000::i16, -500::i16) = true::bool
lte(-500::i16, -1000::i16) = false::bool
lte(-5.75::fp32, -2.25::fp32) = true::bool
lte(-2.25::fp32, -5.75::fp32) = false::bool
lte(-100.50::fp64, -50.25::fp64) = true::bool
lte(-9.99::dec<38, 2>, -5.50::dec<38, 2>) = true::bool

# mixed_magnitude: Mixed magnitude values
lte(-1000000::i32, -500000::i32) = true::bool

# null_handling_extended: Extended null handling scenarios
lte(P5D::iday, null::iday?) = null::bool?
lte(null::iday?, null::iday?) = null::bool?
lte(2020-12-30::date, null::date?) = null::bool?
lte(null::date?, null::date?) = null::bool?
lte(2018-12-31T13:30:15::pts<6>, null::pts?<6>) = null::bool?
lte(null::pts?<6>, null::pts?<6>) = null::bool?
lte(1999-01-08T01:05:06-08:00::ptstz<6>, null::ptstz?<6>) = null::bool?
lte(null::ptstz?<6>, null::ptstz?<6>) = null::bool?
lte(P5Y::iyear, null::iyear?) = null::bool?
lte(null::iyear?, null::iyear?) = null::bool?

# zero_handling: Zero and negative zero handling
lte(2020-12-31T23:59:59::pts<6>, 2021-01-01T00:00:00::pts<6>) = true::bool
lte(2021-01-01T00:00:00::pts<6>, 2020-12-31T23:59:59::pts<6>) = false::bool
lte(1999-01-08T09:05:06+00:00::ptstz<6>, 1999-01-08T01:05:06-08:00::ptstz<6>) = true::bool
lte(1999-01-08T00:00:00+12:00::ptstz<6>, 1999-01-07T12:00:00+00:00::ptstz<6>) = true::bool
lte(1999-01-08T00:00:00-12:00::ptstz<6>, 1999-01-08T12:00:00+00:00::ptstz<6>) = true::bool

# negative_values: Negative number handling
lte(0001-01-01::date, 0001-01-01::date) = true::bool
lte(0001-01-01::date, 9999-12-31::date) = true::bool
lte(9999-12-31::date, 9999-12-31::date) = true::bool
lte(9999-12-31::date, 0001-01-01::date) = false::bool
lte(2020-02-29::date, 2020-03-01::date) = true::bool
lte(2020-02-29::date, 2020-02-29::date) = true::bool
lte(2020-02-29::date, 2020-02-28::date) = false::bool
lte(2000-02-29::date, 1900-03-01::date) = false::bool
lte(2020-12-31T23:59:59::pts<6>, 2020-12-31T23:59:59::pts<6>) = true::bool

# additional_coverage: Additional test coverage
lte(P0D::iday, P1D::iday) = true::bool
lte(P0D::iday, P0D::iday) = true::bool
lte(P1D::iday, P0D::iday) = false::bool
lte(P0Y::iyear, P1Y::iyear) = true::bool
lte(P0Y::iyear, P0Y::iyear) = true::bool
lte(P999999Y::iyear, P999999Y::iyear) = true::bool
lte(P999998Y::iyear, P999999Y::iyear) = true::bool
lte(P999999Y::iyear, P999998Y::iyear) = false::bool
lte(P999999D::iday, P999999D::iday) = true::bool
