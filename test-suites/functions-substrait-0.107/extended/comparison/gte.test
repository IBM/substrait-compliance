### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_comparison

# edge_cases: Boundary values and extreme inputs
gte(127::i8, 127::i8) = true::bool
gte(127::i8, 126::i8) = true::bool
gte(-128::i8, -127::i8) = false::bool
gte(-128::i8, -128::i8) = true::bool
gte(-128::i8, 127::i8) = false::bool
gte(127::i8, -128::i8) = true::bool
gte(32767::i16, 32766::i16) = true::bool
gte(32767::i16, 32767::i16) = true::bool
gte(-32768::i16, -32767::i16) = false::bool
gte(-32768::i16, -32768::i16) = true::bool
gte(-32768::i16, 32767::i16) = false::bool
gte(32767::i16, -32768::i16) = true::bool
gte(2147483647::i32, 2147483646::i32) = true::bool
gte(2147483647::i32, 2147483647::i32) = true::bool
gte(-2147483648::i32, -2147483647::i32) = false::bool
gte(-2147483648::i32, -2147483648::i32) = true::bool
gte(-2147483648::i32, 2147483647::i32) = false::bool
gte(2147483647::i32, -2147483648::i32) = true::bool
gte(9223372036854775807::i64, 9223372036854775806::i64) = true::bool
gte(9223372036854775807::i64, 9223372036854775807::i64) = true::bool
gte(-9223372036854775808::i64, -9223372036854775807::i64) = false::bool
gte(-9223372036854775808::i64, -9223372036854775808::i64) = true::bool
gte(-9223372036854775808::i64, 9223372036854775807::i64) = false::bool
gte(9223372036854775807::i64, -9223372036854775808::i64) = true::bool

# special_values: Special floating point values (NaN, Infinity)
gte(1.0::fp32, nan::fp32) = false::bool
gte(1.0::fp64, nan::fp64) = false::bool
gte(inf::fp32, inf::fp32) = true::bool
gte(-inf::fp32, -inf::fp32) = true::bool
gte(inf::fp32, 1.0::fp32) = true::bool
gte(-inf::fp32, -1.0::fp32) = false::bool
gte(1.0::fp32, inf::fp32) = false::bool
gte(-1.0::fp32, -inf::fp32) = true::bool
gte(inf::fp32, -inf::fp32) = true::bool
gte(-inf::fp32, inf::fp32) = false::bool

# zero_handling: Zero and negative zero handling
gte(-0.0::fp32, 0.0::fp32) = true::bool
gte(0.0::fp32, -0.0::fp32) = true::bool
gte(-0.0::fp64, 0.0::fp64) = true::bool
gte(0.0::fp64, -0.0::fp64) = true::bool
gte(0.0::fp64, 0.0::fp64) = true::bool
gte(0::i8, 0::i8) = true::bool
gte(0::i16, 0::i16) = true::bool
gte(0::i32, 0::i32) = true::bool
gte(0::i64, 0::i64) = true::bool
gte(0.0::fp32, 0.0::fp32) = true::bool
gte(0::i32, -1::i32) = true::bool
gte(-1::i32, 0::i32) = false::bool

# negative_values: Negative number handling
gte(-1.5::fp64, -2.5::fp64) = true::bool
gte(-2.5::fp64, -1.5::fp64) = false::bool
gte(-1::i8, -2::i8) = true::bool
gte(-2::i8, -1::i8) = false::bool
gte(-100::i16, -200::i16) = true::bool
gte(-200::i16, -100::i16) = false::bool

# type_coverage: Various data type coverage
gte(1.5::fp64, 1.5::fp64) = true::bool
gte(2.5::fp64, 1.5::fp64) = true::bool
gte(1.5::fp64, 2.5::fp64) = false::bool

# mixed_magnitude: Mixed magnitude values
gte(-1000000::i32, -2000000::i32) = true::bool
gte(-2000000::i32, -1000000::i32) = false::bool
gte(-1000000000000::i64, -2000000000000::i64) = true::bool
gte(-2000000000000::i64, -1000000000000::i64) = false::bool

# null_handling_extended: Extended null handling scenarios
gte(2020-12-30::date, null::date?) = null::bool?
gte(P5D::iday, null::iday?) = null::bool?
gte(P5Y::iyear, null::iyear?) = null::bool?
gte(2018-12-31T13:30:15::pts<6>, null::pts?<6>) = null::bool?
gte(1999-01-08T01:05:06-08:00::ptstz<6>, null::ptstz?<6>) = null::bool?
gte(null::iyear?, P5Y::iyear) = null::bool?
gte(null::ptstz?<6>, 1999-01-08T01:05:06-08:00::ptstz<6>) = null::bool?

# zero_handling: Zero and negative zero handling
gte(2017-12-31T13:30:15.000001::pts<6>, 2017-12-31T13:30:15.000000::pts<6>) = true::bool
gte(2017-12-31T13:30:15.000000::pts<6>, 2017-12-31T13:30:15.000001::pts<6>) = false::bool

# negative_values: Negative number handling
gte(P-5D::iday, P5D::iday) = false::bool
gte(P5D::iday, P-5D::iday) = true::bool
gte(P-3Y::iyear, P2Y::iyear) = false::bool
gte(P2Y::iyear, P-3Y::iyear) = true::bool
gte(9999-12-31::date, 0001-01-01::date) = true::bool
gte(0001-01-01::date, 0001-01-01::date) = true::bool
gte(0001-01-01::date, 9999-12-31::date) = false::bool
gte(2017-12-31T13:30:15.999999::pts<6>, 2017-12-31T13:30:15.999999::pts<6>) = true::bool

# additional_coverage: Additional test coverage
gte(P0D::iday, P0D::iday) = true::bool
gte(P0D::iday, P1D::iday) = false::bool
gte(P0Y::iyear, P1Y::iyear) = false::bool
gte(P1Y::iyear, P0Y::iyear) = true::bool
