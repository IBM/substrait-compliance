### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_comparison

# edge_cases: Boundary values and extreme inputs
is_null(127::i8) = false::bool
is_null(-128::i8) = false::bool
is_null(2147483647::i32) = false::bool
is_null(-2147483648::i32) = false::bool
is_null(9223372036854775807::i64) = false::bool
is_null(-9223372036854775808::i64) = false::bool

# special_values: Special floating point values (NaN, Infinity)
is_null(nan::fp32) = false::bool
is_null(inf::fp32) = false::bool
is_null(-inf::fp32) = false::bool
is_null(nan::fp64) = false::bool
is_null(inf::fp64) = false::bool
is_null(-inf::fp64) = false::bool

# null_handling_extended: Extended null handling scenarios
is_null(0::i8) = false::bool
is_null(null::i8?) = true::bool
is_null(0::i32) = false::bool
is_null(null::i32?) = true::bool
is_null(0::i64) = false::bool
is_null(null::i64?) = true::bool
is_null(0.0::fp32) = false::bool
is_null(-1.5::fp32) = false::bool
is_null(null::fp32?) = true::bool
is_null(0.0::fp64) = false::bool
is_null(3.14159::fp64) = false::bool
is_null(-273.15::fp64) = false::bool
is_null(null::fp64?) = true::bool
is_null('hello'::str) = false::bool
is_null(''::str) = false::bool
is_null(null::str?) = true::bool
is_null('world'::str) = false::bool
is_null('a'::fchar<1>) = false::bool
is_null(null::fchar?<10>) = true::bool
is_null(true::bool) = false::bool
is_null(null::bool?) = true::bool
is_null(2024-01-15::date) = false::bool
is_null(null::date?) = true::bool
is_null(12:30:45::pt<6>) = false::bool
is_null(null::pt?<6>) = true::bool
is_null(2024-01-15T12:30:45::pts<6>) = false::bool
is_null(null::pts?<6>) = true::bool
is_null(null::iyear?) = true::bool
is_null(null::binary?) = true::bool
