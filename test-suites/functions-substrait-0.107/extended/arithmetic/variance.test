### SUBSTRAIT_AGGREGATE_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# basic: Basic examples without any special cases
((2.0), (4.0), (6.0), (8.0)) variance(POPULATION::enum, col0::fp64) = 5.0::fp64

# uniform: Examples with uniform values
((10.0), (10.0), (10.0)) variance(POPULATION::enum, col0::fp64) = 0.0::fp64

# negative: Examples with negative numbers
((-2.5), (-1.5), (-0.5), (0.5), (1.5), (2.5)) variance(POPULATION::enum, col0::fp64) = 2.9166666666666665::fp64

# single_value: Examples with single value
((3.14)) variance(POPULATION::enum, col0::fp64) = 0.0::fp64

# zero_handling: Zero and negative zero handling
((5.0), (15.0)) variance(POPULATION::enum, col0::fp64) = 25.0::fp64
((0.0), (0.0)) variance(POPULATION::enum, col0::fp64) = 0.0::fp64
((1e308), (1e308), (1e308)) variance(POPULATION::enum, col0::fp64) = 0.0::fp64

# negative_values: Negative number handling
((2.5), (-2.5), (2.5), (-2.5)) variance(POPULATION::enum, col0::fp64) = 6.25::fp64

# mixed_magnitude: Mixed magnitude values
((1e100), (2e100), (3e100)) variance(POPULATION::enum, col0::fp64) = 6.666666666666667e+199::fp64
((1e100), (-1e100), (1e100), (-1e100)) variance(POPULATION::enum, col0::fp64) = 1e+200::fp64
