### SUBSTRAIT_AGGREGATE_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# edge_cases: Boundary values and extreme inputs
sum((127, 127)::i8) = 254::i64
sum((-128, -128)::i8) = -256::i64
sum((32767, 32767)::i16) = 65534::i64
sum((-32768, -32768)::i16) = -65536::i64
sum((2147483647, 2147483647)::i32) = 4294967294::i64
sum((-2147483648, -2147483648)::i32) = -4294967296::i64
sum((9223372036854775807)::i64) = 9223372036854775807::i64
sum((-9223372036854775808)::i64) = -9223372036854775808::i64
sum((9223372036854775807, -1)::i64) = 9223372036854775806::i64
sum((9223372036854775807, -9223372036854775807)::i64) = 0::i64
sum((-9223372036854775808, 9223372036854775807)::i64) = -1::i64

# overflow_behavior: Overflow and saturation behavior
sum((-9223372036854775808, -1)::i64) [overflow:ERROR] = <!ERROR>
sum((-9223372036854775807, -2)::i64) [overflow:ERROR] = <!ERROR>
sum((-9223372036854775808, -1, -1, -1)::i64) [overflow:ERROR] = <!ERROR>

# special_values: Special floating point values (NaN, Infinity)
sum((NaN, 1.0, 2.0)::fp32) = nan::fp64
sum((1.0, NaN, 2.0)::fp64) = nan::fp64
sum((NaN, NaN, NaN)::fp64) = nan::fp64
sum((2.5, NaN, -2.5)::fp32) = nan::fp64

# zero_handling: Zero and negative zero handling
sum((0, 0, 0, 0)::i32) = 0::i64
sum((0, 0, 0)::i8) = 0::i64
sum((0.0, 0.0, 0.0)::fp32) = 0.0::fp64
sum((0.0)::fp64) = 0.0::fp64

# single_value: Single value inputs
sum((42)::i8) = 42::i64
sum((1000)::i16) = 1000::i64
sum((100000)::i32) = 100000::i64
