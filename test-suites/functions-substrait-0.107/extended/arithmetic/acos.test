### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# special_values: Special floating point values (NaN, Infinity)
acos(1.1::fp64) [on_domain_error:NAN] = nan::fp64
acos(-1.1::fp64) [on_domain_error:NAN] = nan::fp64
acos(2.0::fp32) [on_domain_error:NAN] = nan::fp32
acos(-2.0::fp32) [on_domain_error:NAN] = nan::fp32
acos(nan::fp64) = nan::fp64
acos(nan::fp32) = nan::fp32
acos(inf::fp64) [on_domain_error:NAN] = nan::fp64
acos(-inf::fp64) [on_domain_error:NAN] = nan::fp64
acos(inf::fp32) [on_domain_error:NAN] = nan::fp32

# zero_handling: Zero and negative zero handling
acos(-1.0::fp64) = 3.141592653589793::fp64
acos(1.0::fp32) = 0.0::fp32
acos(-1.0::fp32) = 3.1415927::fp32
acos(0.5::fp64) = 1.0471975511965979::fp64
acos(-0.5::fp64) = 2.0943951023931957::fp64
acos(0.7071067811865476::fp64) = 0.7853981633974483::fp64
acos(0.5::fp32) = 1.0471976::fp32
acos(0.0::fp32) = 1.5707964::fp32
acos(0.8660254::fp32) = 0.5235988::fp32
