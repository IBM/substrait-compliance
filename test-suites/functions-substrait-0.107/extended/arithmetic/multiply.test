### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# edge_cases: Boundary values and extreme inputs
multiply(0::i8, 127::i8) = 0::i8
multiply(0::i8, -128::i8) = 0::i8
multiply(0::i16, 32767::i16) = 0::i16
multiply(0::i32, -2147483648::i32) = 0::i32
multiply(127::i8, 0::i8) = 0::i8
multiply(1::i32, 2147483647::i32) = 2147483647::i32
multiply(1::i64, -9223372036854775808::i64) = -9223372036854775808::i64
multiply(127::i8, 1::i8) = 127::i8
multiply(-128::i8, 1::i8) = -128::i8
multiply(127::i8, -1::i8) = -127::i8

# overflow_behavior: Overflow and saturation behavior
multiply(-128::i8, -1::i8) [overflow:ERROR] = <!ERROR>
multiply(-128::i8, -1::i8) [overflow:SATURATE] = 127::i8
multiply(-32768::i16, -1::i16) [overflow:ERROR] = <!ERROR>
multiply(-32768::i16, -1::i16) [overflow:SATURATE] = 32767::i16
multiply(-2147483648::i32, -1::i32) [overflow:ERROR] = <!ERROR>
multiply(-2147483648::i32, -1::i32) [overflow:SATURATE] = 2147483647::i32
multiply(-9223372036854775808::i64, -1::i64) [overflow:ERROR] = <!ERROR>
multiply(-9223372036854775808::i64, -1::i64) [overflow:SATURATE] = 9223372036854775807::i64
multiply(-13::i8, 10::i8) [overflow:SATURATE] = -128::i8

# null_handling_extended: Extended null handling scenarios
multiply(null::i8?, 5::i8) = null::i8?
multiply(5::i8, null::i8?) = null::i8?
multiply(null::i16?, -100::i16) = null::i16?
multiply(300::i32, null::i32?) = null::i32?
multiply(null::i64?, null::i64?) = null::i64?
multiply(null::fp32?, 2.5::fp32) = null::fp32?
multiply(1.5::fp64, null::fp64?) = null::fp64?

# zero_handling: Zero and negative zero handling
multiply(0::i64, -1000000::i64) = 0::i64
multiply(-5000::i64, 0::i64) = 0::i64
multiply(0.0::fp32, 1000.0::fp32) = 0.0::fp32
multiply(0.0::fp64, -999.999::fp64) = 0.0::fp64
multiply(1.0::fp32, 3.14159::fp32) = 3.14159::fp32
multiply(1.0::fp64, -2.71828::fp64) = -2.71828::fp64

# negative_values: Negative number handling
multiply(1::i16, -500::i16) = -500::i16
multiply(-1::i8, 100::i8) = -100::i8
multiply(-1::i16, 100::i16) = -100::i16
multiply(-1::i32, 42::i32) = -42::i32
multiply(-1::i64, -1000::i64) = 1000::i64

# type_coverage: Various data type coverage
multiply(1::i8, 42::i8) = 42::i8
multiply(42::i8, 1::i8) = 42::i8
