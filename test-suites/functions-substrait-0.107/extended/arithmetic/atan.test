### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# special_values: Special floating point values (NaN, Infinity)
atan(inf::fp32) = 1.5707963267948966::fp32
atan(-inf::fp32) = -1.5707963267948966::fp32
atan(nan::fp32) = nan::fp32
atan(nan::fp64) = nan::fp64

# zero_handling: Zero and negative zero handling
atan(-0.0::fp32) = -0.0::fp32
atan(-0.0::fp64) = -0.0::fp64
atan(-1.0::fp32) = -0.7853981633974483::fp32
atan(-1.0::fp64) = -0.7853981633974483::fp64

# precision: Floating point precision and small values
atan(1.0e-38::fp32) = 1.0e-38::fp32
atan(-1.0e-38::fp32) = -1.0e-38::fp32
atan(1.0e-308::fp64) = 1.0e-308::fp64
atan(-1.0e-308::fp64) = -1.0e-308::fp64

# negative_values: Negative number handling
atan(-5.5::fp32) = -1.3909428270024184::fp32
atan(-1.0e38::fp32) = -1.5707963267948966::fp32
atan(-1.7320508075688772::fp64) = -1.0471975511965979::fp64

# type_coverage: Various data type coverage
atan(5.5::fp32) = 1.3909428270024184::fp32
atan(1.0e38::fp32) = 1.5707963267948966::fp32
atan(1.7320508075688772::fp64) = 1.0471975511965979::fp64
