### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# edge_cases: Boundary values and extreme inputs
abs(127::i8) = 127::i8
abs(32767::i16) = 32767::i16
abs(2147483647::i32) = 2147483647::i32
abs(9223372036854775807::i64) = 9223372036854775807::i64
abs(-127::i8) = 127::i8
abs(-32767::i16) = 32767::i16
abs(-2147483647::i32) = 2147483647::i32
abs(-9223372036854775807::i64) = 9223372036854775807::i64

# overflow_behavior: Overflow and saturation behavior
abs(-32768::i16) [overflow:ERROR] = <!ERROR>
abs(-32768::i16) [overflow:SATURATE] = 32767::i16
abs(-32768::i16) [overflow:SILENT] = <!UNDEFINED>
abs(-2147483648::i32) [overflow:ERROR] = <!ERROR>
abs(-2147483648::i32) [overflow:SATURATE] = 2147483647::i32
abs(-2147483648::i32) [overflow:SILENT] = <!UNDEFINED>
abs(-9223372036854775808::i64) [overflow:ERROR] = <!ERROR>
abs(-9223372036854775808::i64) [overflow:SATURATE] = 9223372036854775807::i64
abs(-9223372036854775808::i64) [overflow:SILENT] = <!UNDEFINED>

# special_values: Special floating point values (NaN, Infinity)
abs(inf::fp32) = inf::fp32
abs(-inf::fp32) = inf::fp32
abs(nan::fp32) = nan::fp32
abs(inf::fp64) = inf::fp64
abs(-inf::fp64) = inf::fp64
abs(nan::fp64) = nan::fp64

# zero_handling: Zero and negative zero handling
abs(0::i8) = 0::i8
abs(0::i16) = 0::i16
abs(0::i32) = 0::i32
abs(0::i64) = 0::i64
abs(0.0::fp32) = 0.0::fp32
abs(-0.0::fp32) = 0.0::fp32
abs(0.0::fp64) = 0.0::fp64
abs(-0.0::fp64) = 0.0::fp64
