### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# special_values: Special floating point values (NaN, Infinity)
sinh(inf::fp32) = inf::fp32
sinh(-inf::fp32) = -inf::fp32
sinh(inf::fp64) = inf::fp64
sinh(-inf::fp64) = -inf::fp64
sinh(nan::fp32) = nan::fp32
sinh(nan::fp64) = nan::fp64

# zero_handling: Zero and negative zero handling
sinh(-0.0::fp32) = -0.0::fp32
sinh(-0.0::fp64) = -0.0::fp64
sinh(1.0::fp32) = 1.1752012::fp32
sinh(-1.0::fp32) = -1.1752012::fp32
sinh(5.0::fp32) = 74.20321::fp32
sinh(710.0::fp64) = 1.1169973830808557e+308::fp64
sinh(-710.0::fp64) = -1.1169973830808557e+308::fp64

# precision: Floating point precision and small values
sinh(1e-10::fp32) = 1e-10::fp32
sinh(-1e-10::fp32) = -1e-10::fp32
sinh(1e-15::fp64) = 1e-15::fp64
sinh(-1e-15::fp64) = -1e-15::fp64

# negative_values: Negative number handling
sinh(-2.5::fp32) = -6.0502043::fp32

# type_coverage: Various data type coverage
sinh(2.5::fp32) = 6.0502043::fp32
