### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# basic: Basic modulo examples
modulus(10::i32, 3::i32) = 1::i32
modulus(17::i32, 5::i32) = 2::i32
modulus(20::i32, 4::i32) = 0::i32
modulus(7::i64, 3::i64) = 1::i64
modulus(100::i64, 7::i64) = 2::i64

# negative: Modulo with negative numbers
modulus(-10::i32, 3::i32) = -1::i32
modulus(10::i32, -3::i32) = 1::i32
modulus(-10::i32, -3::i32) = -1::i32
modulus(-17::i64, 5::i64) = -2::i64

# null_handling: Examples with null as input
modulus(null::i32?, 3::i32) = null::i32?
modulus(10::i32, null::i32?) = null::i32?

# types: Examples with different numeric types
modulus(10::i8, 3::i8) = 1::i8
modulus(1000::i16, 7::i16) = 6::i16

# edge_cases: Boundary values and extreme inputs
modulus(2147483647::i32, 1::i32) = 0::i32
modulus(9223372036854775807::i64, 1::i64) = 0::i64
modulus(2147483647::i32, 2::i32) = 1::i32
modulus(-2147483648::i32, 2::i32) = 0::i32
modulus(9223372036854775807::i64, 3::i64) = 1::i64
modulus(-9223372036854775808::i64, 3::i64) = -2::i64
modulus(127::i8, 10::i8) = 7::i8
modulus(-128::i8, 10::i8) = -8::i8

# zero_handling: Zero and negative zero handling
modulus(0::i32, 3::i32) = 0::i32
modulus(0::i64, 5::i64) = 0::i64
modulus(0::i8, 7::i8) = 0::i8
modulus(0::i16, 11::i16) = 0::i16

# type_coverage: Various data type coverage
modulus(999999999::i32, 999999998::i32) = 1::i32

# mixed_magnitude: Mixed magnitude values
modulus(1000000000000::i64, 999999999999::i64) = 1::i64
