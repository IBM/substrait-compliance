### SUBSTRAIT_SCALAR_TEST: v1.0
### SUBSTRAIT_INCLUDE: extension:io.substrait:functions_arithmetic

# edge_cases: Boundary values and extreme inputs
subtract(126::i8, -1::i8) = 127::i8
subtract(-127::i8, 1::i8) = -128::i8
subtract(32766::i16, -1::i16) = 32767::i16
subtract(-32767::i16, 1::i16) = -32768::i16
subtract(2147483646::i32, -1::i32) = 2147483647::i32
subtract(-2147483647::i32, 1::i32) = -2147483648::i32

# overflow_behavior: Overflow and saturation behavior
subtract(127::i8, -1::i8) [overflow:ERROR] = <!ERROR>
subtract(-128::i8, 1::i8) [overflow:ERROR] = <!ERROR>
subtract(32767::i16, -1::i16) [overflow:ERROR] = <!ERROR>
subtract(-32768::i16, 1::i16) [overflow:ERROR] = <!ERROR>
subtract(2147483647::i32, -1::i32) [overflow:ERROR] = <!ERROR>
subtract(-2147483648::i32, 1::i32) [overflow:ERROR] = <!ERROR>
subtract(9223372036854775807::i64, -1::i64) [overflow:ERROR] = <!ERROR>

# null_handling_extended: Extended null handling scenarios
subtract(null::i8?, 5::i8) = null::i8?
subtract(5::i8, null::i8?) = null::i8?
subtract(null::i32?, null::i32?) = null::i32?
subtract(null::i64?, 100::i64) = null::i64?
subtract(-50::i16, null::i16?) = null::i16?

# zero_handling: Zero and negative zero handling
subtract(0::i8, 0::i8) = 0::i8
subtract(0::i16, 0::i16) = 0::i16
subtract(0::i32, 0::i32) = 0::i32
subtract(0::i64, 0::i64) = 0::i64
subtract(0::fp32, 0::fp32) = 0::fp32
subtract(0::fp64, 0::fp64) = 0::fp64
subtract(-5.5::fp32, 2.5::fp32) = -8.0::fp32
subtract(-100.5::fp64, -50.5::fp64) = -50.0::fp64

# type_coverage: Various data type coverage
subtract(10.5::fp32, 3.2::fp32) = 7.3::fp32
subtract(100.75::fp64, 50.25::fp64) = 50.5::fp64
